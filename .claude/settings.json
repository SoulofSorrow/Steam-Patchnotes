{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ruff check:*)",
      "Bash(ruff format --check:*)",
      "Bash(python -m compileall workshop_changelogs)",
      "Bash(python3 -m compileall workshop_changelogs)",
      "Bash(pre-commit run:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(docker-compose up:*)",
      "Bash(docker compose up:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./config.json)"
    ]
  }
}
